DATABASE_URL=sqlite:///./resqai.db
JWT_SECRET=replace-with-a-long-random-secret
DEMO_USER_EMAIL=sumith@sahaaya.demo
DEMO_USER_PASSWORD=demo-preview
DEMO_USER_NAME=Sumith Choudhary
DEMO_ADMIN_PASSWORD=demo-admin-preview
DEMO_VIEWER_PASSWORD=demo-viewer-preview
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
SAHAAYA_INGESTION_ENABLED=false
SAHAAYA_INGESTION_INTERVAL_SECONDS=900

# Public feeds with documented anonymous access can be triggered manually.
# Set SAHAAYA_INGESTION_ENABLED=true after reviewing feed cadence/terms to poll them.
USGS_EARTHQUAKE_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
GDACS_EVENTS_URL=https://www.gdacs.org/gdacsapi/api/Events/geteventlist/SEARCH

# Do not guess IMD auth. Supply endpoints and exact authorized headers from the account instructions.
IMD_ENDPOINTS_JSON={}
IMD_AUTH_HEADERS_JSON={}

# SACHET requires the feed identifier obtained through its subscription process.
SACHET_CAP_FEED_URL=

# Configure the exact NWIC resource download/API URL and approved column mapping.
NWIC_TELANGANA_RAINFALL_URL=

# No public CWC API path is assumed; configure only a verified, authorized feed.
CWC_FLOOD_FEED_URL=
